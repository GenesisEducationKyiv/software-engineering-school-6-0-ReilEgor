# Notification service (container: notification-sender)

# ============================
# APP IDENTITY
# ============================
APP_BASE_URL=http://localhost:${APP_HTTP_PORT}

# ============================
# EMAIL
# ============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=user
EMAIL_PASSWORD=password
EMAIL_FROM=from_email_address

# ============================
# SENDER
# ============================
WORKER_SEND_TIMEOUT=5s
SENDER_HEALTH_PORT=${SENDER_HEALTH_PORT}

# ============================
# MESSAGE BROKER
# ============================
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
