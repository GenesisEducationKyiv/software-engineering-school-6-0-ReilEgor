apiVersion: v1
kind: Secret
metadata:
  name: subscription-secret
type: Opaque
stringData:
  SUBSCRIPTION_DB_SOURCE: "postgres://user:password@postgres-subscription:5432/subscription_db?sslmode=disable"
  APP_API_KEY: "my-super-secret-token-123"
  REDIS_PASSWORD: "password"
  RABBITMQ_URL: "amqp://guest:guest@rabbitmq:5672/"
