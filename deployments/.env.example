# ============================
# COMMON / SHARED
# ============================
# Values used directly by docker-compose.yml itself (host port mappings,
# infra container credentials, migrate commands) and/or referenced via
# ${VAR} interpolation from the per-service files in ./env/*.env.
#
# Service-specific configuration lives in ./env/<service>.env.example.
# ============================

# ============================
# DATABASE
# ============================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_strong_password

SUBSCRIPTION_POSTGRES_DB=subscription_db
SUBSCRIPTION_POSTGRES_PORT=5432
TRACKER_POSTGRES_DB=tracker_db

# ============================
# APPLICATION
# ============================
APP_HTTP_PORT=8080
APP_GRPC_PORT=9091
TRACKING_GRPC_PORT=50051

# ============================
# REDIS
# ============================
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================
# MESSAGE BROKER
# ============================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ============================
# Metrics
# ============================
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090

# ============================
# WORKER / SENDER HEALTHCHECKS
# ============================
WORKER_HEALTH_PORT=8081
SENDER_HEALTH_PORT=8082

# ============================
# Documentation
# ============================
SWAGGER_PORT=9080
